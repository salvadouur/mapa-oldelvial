# Supabase — sin estas variables el sitio arranca igual, con el contenido de
# demostración de src/lib/content/seed.ts. Copiar a .env.local y completar.
#
# Sirve cualquiera de las dos claves públicas: la publishable (sb_publishable_…)
# es la recomendada, porque se rota sola sin tocar el resto del proyecto. La
# anon (eyJ…) es la histórica y se sigue aceptando.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts de mantenimiento fuera de la app (nunca en el cliente).
SUPABASE_SERVICE_ROLE_KEY=
